# ---------------------------------------------------------------------------
# Ganesha Guide configuration. Copy to `.env` and fill in your own values.
# Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# Which AI provider to use: groq (default) | gemini | openrouter | custom
LLM_PROVIDER=groq

# --- Groq (recommended, free tier, no card required) -----------------------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Google Gemini (alternative) ---------------------------------------------
# Create a key at https://aistudio.google.com/apikey and set LLM_MODEL to a
# current model id from https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=

# --- OpenRouter (alternative) ------------------------------------------------
# Create a key at https://openrouter.ai/keys and set LLM_MODEL to a ':free' model
OPENROUTER_API_KEY=

# Optional overrides
# LLM_MODEL=openai/gpt-oss-120b   # Groq default; also try qwen/qwen3.8-27b or openai/gpt-oss-20b
# LLM_BASE_URL=            # required only when LLM_PROVIDER=custom (any OpenAI-compatible API)
# LLM_API_KEY=             # key for LLM_PROVIDER=custom
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT_SECONDS=30

# Chat limits
# MAX_MESSAGE_CHARS=4000
# MAX_HISTORY_MESSAGES=20

# Server
# HOST=127.0.0.1
# PORT=5050          # avoid 5000: macOS AirPlay Receiver uses it
# FLASK_DEBUG=0
# LOG_LEVEL=INFO
